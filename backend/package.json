{
  "name": "fizika-lab-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply fizika-lab-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fizika-lab-db --remote",
    "db:init:local": "wrangler d1 execute fizika-lab-db --local --file=src/db/schema.sql && wrangler d1 execute fizika-lab-db --local --file=src/db/seed.sql",
    "db:seed:local": "wrangler d1 execute fizika-lab-db --local --file=src/db/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.5.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240821.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.5.4",
    "wrangler": "^3.72.0"
  }
}
